{
  "name": "agentman-desktop",
  "version": "0.22.0",
  "private": true,
  "description": "Agent manager desktop application",
  "author": "Agent Manager contributors",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/build-icon.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:smoke": "node --import tsx tests/smoke.ts",
    "test:packaged": "node --import tsx tests/packaged-smoke.ts",
    "dist": "npm run build && node scripts/prepare-package.mjs && node scripts/dist.mjs",
    "typecheck:tests": "tsc --project tsconfig.tests.json"
  },
  "dependencies": {
    "@ai-agent-manager/cli": "file:.."
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.0",
    "vitest": "5.0.1"
  }
}
