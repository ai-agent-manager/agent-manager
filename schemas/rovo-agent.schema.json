{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-manager.dev/schemas/rovo-agent.schema.json",
  "title": "Rovo Agent Manifest (v2-beta)",
  "description": "Schema for rovo-agent.yaml — defines an Atlassian Studio Rovo agent for automated provisioning. v1 is archived; only v2-beta is supported.",
  "type": "object",
  "required": ["apiVersion", "kind", "name", "description", "instructions"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "rovo.atlassian.com/v2-beta",
      "description": "API version identifier. Must be 'rovo.atlassian.com/v2-beta'."
    },
    "kind": {
      "type": "string",
      "const": "StudioAgent",
      "description": "Resource kind. Must be 'StudioAgent'."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "description": "Agent display name (max 30 characters in Studio)."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "description": "Short agent description (max 400 characters in Studio)."
    },
    "avatar": {
      "type": "string",
      "description": "Optional emoji or short avatar string."
    },
    "instructions": {
      "$ref": "#/$defs/stringOrFileRef",
      "description": "Merged behaviour + default instructions for the agent. Inline string or $file reference."
    },
    "conversationStarters": {
      "type": "array",
      "description": "Optional conversation starter prompts (max 3 in Studio).",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "skills": {
      "type": "array",
      "description": "Skills (actions) available to the agent.",
      "items": { "type": "string", "minLength": 1 }
    },
    "knowledge": {
      "type": "string",
      "enum": ["all", "custom", "none"],
      "default": "all"
    },
    "webSearch": { "type": "boolean", "default": false },
    "deepResearch": { "type": "boolean", "default": false },
    "subagents": {
      "type": "object",
      "description": "Subagents map. Keys are stable identifiers; each entry must include a name and enabled flag.",
      "additionalProperties": { "$ref": "#/$defs/subagent" }
    },
    "knowledgeSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/knowledgeSource" }
    }
  },
  "$defs": {
    "subagent": {
      "type": "object",
      "description": "A v2-beta subagent — replaces v1 custom scenarios.",
      "required": ["name", "enabled"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "trigger": { "type": "string" },
        "instructions": { "$ref": "#/$defs/stringOrFileRef" },
        "conversationStarters": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "skills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "knowledge": { "type": "string", "enum": ["all", "custom", "none"] },
        "webSearch": { "type": "boolean" },
        "deepResearch": { "type": "boolean" }
      }
    },
    "fileRef": {
      "type": "object",
      "description": "Reference to an external file whose text contents replace this value. The path is resolved relative to the rovo-agent.yaml directory.",
      "required": ["$file"],
      "additionalProperties": false,
      "properties": {
        "$file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.(/|$))",
          "description": "Relative path to a text file. Must not be absolute or escape the directory with '..'."
        }
      }
    },
    "stringOrFileRef": {
      "description": "Either an inline string or a { $file: './path' } reference to external file content.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/fileRef" }
      ]
    },
    "knowledgeSource": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["confluence", "jira", "jsm", "atlassian-support-docs"]
        },
        "filter": { "type": "string" }
      }
    }
  }
}
