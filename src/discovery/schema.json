{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmanager.dev/schemas/discovery/v1.json",
  "title": "Agent Manager Discovery Document",
  "description": "Discovery document for agent-manager, served at <base_url>/.well-known/agents/discovery.json",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1",
      "description": "Schema version"
    },
    "auth": {
      "type": "object",
      "description": "Authentication configuration. Omit entirely if no authentication is required.",
      "required": ["required"],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Whether authentication is needed to access skills from this endpoint"
        },
        "oidcDiscoveryUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to the standard OIDC discovery document (e.g. https://auth.example.com/.well-known/openid-configuration)"
        },
        "clientId": {
          "type": "string",
          "description": "OAuth2 client ID that agent-manager should use"
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["openid"],
          "description": "OAuth2 scopes to request. Defaults to [\"openid\"] if omitted."
        }
      },
      "if": {
        "properties": { "required": { "const": true } }
      },
      "then": {
        "required": ["required", "oidcDiscoveryUrl", "clientId"]
      }
    },
    "telemetry": {
      "type": "object",
      "description": "Telemetry configuration. Omit entirely to leave telemetry unconfigured (env vars still apply).",
      "required": ["url", "siteId"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Base URL of the telemetry endpoint (e.g. https://telemetry.example.com)"
        },
        "siteId": {
          "type": "string",
          "description": "Site identifier for the telemetry service"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "description": "List of available sources",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["name", "type", "indexUrl"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Source identifier (kebab-case recommended)"
              },
              "type": {
                "const": "http",
                "description": "HTTP bundle source"
              },
              "indexUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://.+/index\\.json(?:[?#].*)?$",
                "description": "Preferred exact HTTP(S) URL to the bundle index.json"
              },
              "status": {
                "type": "string",
                "enum": ["official", "community"],
                "description": "Trust level indicator"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["name", "type", "url"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Source identifier (kebab-case recommended)"
              },
              "type": {
                "const": "http",
                "description": "Legacy HTTP bundle source"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Legacy base URL; the index is resolved at <url>/agents/index.json"
              },
              "status": {
                "type": "string",
                "enum": ["official", "community"],
                "description": "Trust level indicator"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["name", "type", "url"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Source identifier (kebab-case recommended)"
              },
              "type": {
                "type": "string",
                "enum": ["git", "artefact"],
                "description": "How to fetch the source"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Repository URL for git or direct zip URL for artefact"
              },
              "status": {
                "type": "string",
                "enum": ["official", "community"],
                "description": "Trust level indicator"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
