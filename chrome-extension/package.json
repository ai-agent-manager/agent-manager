{
  "private": true,
  "name": "agentman-chrome-extension",
  "version": "0.1.0",
  "description": "Chrome extension for provisioning Atlassian Rovo agents via Agent Manager",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "node esbuild.config.mjs --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
