{
  "version": "1",
  "api": {
    "baseUrl": "http://localhost:8080",
    "features": {
      "projects": true
    }
  },
  "auth": {
    "required": true,
    "oidcDiscoveryUrl": "http://localhost:8080/oidc/.well-known/openid-configuration",
    "clientId": "agent-manager",
    "scopes": ["openid", "profile", "email"]
  },
  "sources": [
    {
      "name": "mock-bundle",
      "type": "http",
