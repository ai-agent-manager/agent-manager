{
  "name": "@ai-agent-manager/cli",
  "version": "0.17.0",
  "description": "Agent Manager - install and manage AI agent skills and Rovo agents",
  "type": "module",
  "bin": {
    "agentman": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/**/*",
    "assets/**/*",
    "schemas/**/*",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc",
    "build:chrome-extension": "npm run build:crx --prefix chrome-extension && mkdir -p assets && cp chrome-extension/dist/agentman.crx assets/agentman.crx",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "skills",
    "cli",
    "tui",
    "ai",
    "agent-skills",
    "agentman",
    "rovo",
    "claude-code",
    "copilot",
    "cursor",
    "kiro",
    "windsurf"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-agent-manager/agent-manager.git"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@playwright/test": "^1.61.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.4.1",
    "extract-zip": "^2.0.1",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.2.0",
    "react": "^18.3.1",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.2",
    "vitest": "^3.1.0"
  },
  "optionalDependencies": {
    "playwright": "^1.61.0"
  }
}
